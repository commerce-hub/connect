{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "commerce-hub-connect-sdk": {
      "projectType": "library",
      "root": "projects/commerce-hub-connect-angular-app",
      "sourceRoot": "projects/commerce-hub-connect-angular-app/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/commerce-hub-connect-angular-app/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/commerce-hub-connect-angular-app/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/commerce-hub-connect-angular-app/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "commerce-hub-connect-web-sdk-widget": {
      "projectType": "application",
      "root": "projects/commerce-hub-connect-web-sdk",
      "sourceRoot": "projects/commerce-hub-connect-web-sdk/src",
      "prefix": "ch-web-sdk",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "projects/commerce-hub-connect-web-sdk/dist-widget",
            "browser": "projects/commerce-hub-connect-web-sdk/src/main.ts",
            "index": "projects/commerce-hub-connect-web-sdk/src/index.html",
            "polyfills": [],
            "tsConfig": "projects/commerce-hub-connect-web-sdk/tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "styles": [
              "projects/commerce-hub-connect-web-sdk/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/commerce-hub-connect-web-sdk/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "inlineStyleLanguage": "css"
          }
        }
      }
    }
  }
}
