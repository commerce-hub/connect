{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "commercehub-connect-wallet-sdk": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "CommerceHubConnectSDK.js",
                "input": "projects/commerce-hub-connect-web-sdk/dist",
                "output": "/"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "commercehub-connect-wallet-sdk:build:production"
            },
            "development": {
              "buildTarget": "commercehub-connect-wallet-sdk:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          }
        }
      }
    },
    "commerce-hub-connect-sdk": {
      "projectType": "library",
      "root": "projects/commerce-hub-connect-sdk",
      "sourceRoot": "projects/commerce-hub-connect-sdk/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/commerce-hub-connect-sdk/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/commerce-hub-connect-sdk/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/commerce-hub-connect-sdk/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "commerce-hub-connect-web-sdk-widget": {
      "projectType": "application",
      "root": "projects/commerce-hub-connect-web-sdk",
      "sourceRoot": "projects/commerce-hub-connect-web-sdk/src",
      "prefix": "ch-web-sdk",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "projects/commerce-hub-connect-web-sdk/dist-widget",
            "browser": "projects/commerce-hub-connect-web-sdk/src/main.ts",
            "index": "projects/commerce-hub-connect-web-sdk/src/index.html",
            "polyfills": [],
            "tsConfig": "projects/commerce-hub-connect-web-sdk/tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "styles": [
              "projects/commerce-hub-connect-web-sdk/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/commerce-hub-connect-web-sdk/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "inlineStyleLanguage": "css"
          }
        }
      }
    }
  }
}
