{
  "schema": {
    "type": "object",
    "properties": {
      "accountNickname": {
        "type": "string",
        "minLength": 3,
        "description": "Please enter the account nickname",
        "title": "Account Nickname"
      },
      "routingNumber": {
        "type": "string",
        "description": "Please enter the routing number",
        "minLength": 9,
        "maxLength": 9,
        "pattern": "^[0-9]{9}$"
      },
      "accountNumber": {
        "type": "string",
        "description": "Please enter the account number",
        "minLength": 9,
        "maxLength": 9,
        "pattern": "^[0-9]{9}$"
      },
      "confirmAccountNumber": {
        "type": "string",
        "description": "Confirm the account number",
        "minLength": 9,
        "maxLength": 9,
        "pattern": "^[0-9]{9}$"
      }
    },
    "required": [
      "accountNickname",
      "routingNumber",
      "accountNumber",
      "confirmAccountNumber"
    ]
  },
  "validations": [
    {
      "type": "equals",
      "field": "confirmAccountNumber",
      "target": "accountNumber",
      "message": "Account numbers must match."
    }
  ]
}
