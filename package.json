{
  "name": "commerce-hub-connect-sdk",
  "private": true,
  "version": "0.9.4",
  "description": "CommerceHub Connect Web SDK widget primitives",
  "main": "commerce-hub-connect.js",
  "module": "commerce-hub-connect.js",
  "types": "commerce-hub-connect.d.ts",
  "exports": {
    ".": {
      "types": "./commerce-hub-connect.d.ts",
      "import": "./commerce-hub-connect.js"
    }
  },
  "files": [
    "commerce-hub-connect.js",
    "commerce-hub-connect.js.map",
    "commerce-hub-connect.d.ts",
    "commerce-hub-connect.d.ts.map",
    "generated/",
    "internal/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf commerce-hub-connect.{d.ts,d.ts.map,js,js.map} dist generated internal test src/**/*.js src/**/*.js.map src/**/*.d.ts src/**/*.d.ts.map",
    "generate:client": "openapi-typescript swagger.json -o src/generated/openapi.ts && openapi-typescript merchant-swagger.json -o src/generated/merchant-openapi.ts && node scripts/generate-config-openapi.cjs",
    "build:cdn": "npm run build && mkdir -p dist && rollup -c --file dist/commerce-hub-connect.min.js",
    "pack:dist": "npm run build && mkdir -p dist && npm pack --pack-destination dist",
    "lint": "npm run lint:lit-analyzer && npm run lint:eslint",
    "lint:eslint": "eslint 'src/**/*.ts'",
    "lint:lit-analyzer": "lit-analyzer",
    "format": "prettier \"**/*.{cjs,html,js,json,md,ts}\" --ignore-path ./.eslintignore --write",
    "docs": "npm run docs:clean && npm run build && npm run analyze && npm run docs:build && npm run docs:assets && npm run docs:gen",
    "docs:clean": "rimraf docs",
    "docs:gen": "eleventy --config=.eleventy.cjs",
    "docs:gen:watch": "eleventy --config=.eleventy.cjs --watch",
    "docs:build": "rollup -c --file docs/commerce-hub-connect.bundled.js",
    "docs:assets": "cp node_modules/prismjs/themes/prism-okaidia.css docs/",
    "docs:serve": "wds --root-dir=docs --node-resolve --watch",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\"",
    "analyze:watch": "cem analyze --litelement --globs \"src/**/*.ts\" --watch",
    "serve": "wds --watch",
    "serve:prod": "MODE=prod npm run serve",
    "test": "npm run test:proxy-auth && npm run test:package-surface && npm run test:dev && npm run test:prod",
    "test:e2e:add-bank-account": "node e2e-tests/add-bank-account-flow.mjs",
    "test:package-surface": "node --test dev/package-surface_test.js",
    "test:proxy-auth": "node --test dev/commerce-hub-dev-auth_test.js",
    "test:dev": "wtr",
    "test:watch": "wtr --watch",
    "test:prod": "MODE=prod wtr",
    "test:prod:watch": "MODE=prod wtr --watch",
    "checksize": "rollup -c ; cat commerce-hub-connect.bundled.js | gzip -9 | wc -c ; rm commerce-hub-connect.bundled.js"
  },
  "keywords": [
    "web-components",
    "lit-element",
    "typescript",
    "lit"
  ],
  "author": "",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@jsonforms/core": "^3.8.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lit": "^3.2.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^1.0.1",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.0.0",
    "@custom-elements-manifest/analyzer": "^0.6.3",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "@typescript-eslint/eslint-plugin": "^5.25.0",
    "@typescript-eslint/parser": "^5.25.0",
    "@web/dev-server": "^0.1.31",
    "@web/dev-server-legacy": "^1.0.0",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.15.0",
    "@web/test-runner-playwright": "^0.9.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "eslint": "^8.15.0",
    "js-yaml": "^4.1.1",
    "lit-analyzer": "^1.2.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "rollup": "^4.18.0",
    "rollup-plugin-summary": "^2.0.1",
    "typescript": "~5.9.0"
  },
  "customElements": "custom-elements.json",
  "overrides": {
    "axios": "1.16.0",
    "hasown": "2.0.2",
    "unset-value": "2.0.1"
  }
}
