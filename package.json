{
  "name": "commercehub-connect-wallet-sdk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:web-sdk-widget && npm run start:web-sdk-example",
    "start:angular-binding-example": "npm run build:web-sdk-widget && ng serve commerce-hub-connect-angular-example --port 4500 --proxy-config projects/commerce-hub-connect-angular-app/proxy.conf.json",
    "start:react-binding-example": "npm --prefix projects/commerce-hub-connect-react-app run dev -- --host 127.0.0.1 --port 4173",
    "start:web-sdk-example": "node scripts/serve-web-sdk-example.mjs",
    "build": "npm run build:web-sdk-widget && npm run build:angular-binding",
    "build:angular-binding-example": "npm run build:web-sdk-widget && ng build commerce-hub-connect-angular-example && ng build commerce-hub-connect-angular-fixture",
    "build:web-sdk-widget": "node scripts/build-web-sdk-widget.mjs",
    "build:web-sdk-widget:angular": "ng build commerce-hub-connect-web-sdk-widget",
    "test:web-sdk-example-server": "node --test scripts/serve-web-sdk-example.spec.mjs",
    "test:web-sdk-smoke": "node scripts/run-web-sdk-browser-smoke-test.mjs",
    "watch": "ng build commerce-hub-connect-sdk --watch --configuration development",
    "test": "npm run test:angular-binding",
    "build:angular-binding": "ng build commerce-hub-connect-sdk",
    "test:angular-binding": "ng test commerce-hub-connect-sdk --watch=false --browsers=ChromeHeadless",
    "test:angular-binding-example": "ng test commerce-hub-connect-angular-example --watch=false --browsers=ChromeHeadless",
    "test:angular-binding-smoke": "node scripts/run-angular-binding-smoke-test.mjs",
    "typecheck:react-binding": "npm --prefix projects/commerce-hub-connect-react-app run typecheck",
    "build:react-binding": "npm --prefix projects/commerce-hub-connect-react-app run build",
    "pack:web-sdk": "npm run build:web-sdk-widget && cd projects/commerce-hub-connect-web-sdk/dist && npm pack",
    "pack:react-binding": "cd projects/commerce-hub-connect-react-app && npm pack",
    "test:react-binding": "node scripts/run-react-binding-smoke-test.mjs",
    "verify:framework-bindings": "node scripts/verify-framework-binding-wiring.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.19",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.19",
    "@angular/compiler": "20.3.19",
    "@angular/core": "20.3.19",
    "@angular/elements": "^20.3.19",
    "@angular/forms": "20.3.19",
    "@angular/platform-browser": "20.3.19",
    "@angular/router": "20.3.19",
    "@primeuix/themes": "2.0.3",
    "angular-cc-library": "^3.5.1",
    "primeicons": "7.0.0",
    "primeng": "20.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.24",
    "@angular/cli": "20.3.24",
    "@angular/compiler-cli": "20.3.19",
    "@tailwindcss/postcss": "4.1.4",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "20.3.0",
    "tailwindcss": "4.1.4",
    "typescript": "~5.9.2"
  }
}
