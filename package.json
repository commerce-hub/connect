{
  "name": "commercehub-connect-wallet-sdk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4500 --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:sdk": "ng build commerce-hub-connect-sdk",
    "build:web-sdk-widget": "node scripts/build-web-sdk-widget.mjs",
    "build:web-sdk-widget:angular": "ng build commerce-hub-connect-web-sdk-widget",
    "generate:react-app": "node scripts/generate-react-ts-app.mjs",
    "generate:web-sdk": "node scripts/generate-web-sdk.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.19",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.19",
    "@angular/compiler": "20.3.19",
    "@angular/core": "20.3.19",
    "@angular/elements": "^20.3.19",
    "@angular/forms": "20.3.19",
    "@angular/platform-browser": "20.3.19",
    "@angular/router": "20.3.19",
    "@primeuix/themes": "2.0.3",
    "angular-cc-library": "^3.5.1",
    "primeicons": "7.0.0",
    "primeng": "20.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.24",
    "@angular/cli": "20.3.24",
    "@angular/compiler-cli": "20.3.19",
    "@tailwindcss/postcss": "4.1.4",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "20.3.0",
    "tailwindcss": "4.1.4",
    "typescript": "~5.9.2"
  }
}
