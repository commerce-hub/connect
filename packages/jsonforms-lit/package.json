{
  "name": "@jsonforms/lit",
  "version": "0.1.0",
  "description": "Lit web component bindings and default renderers for JSONForms.",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "base-renderers.d.ts",
    "base-renderers.d.ts.map",
    "base-renderers.js",
    "base-renderers.js.map",
    "dispatch.d.ts",
    "dispatch.d.ts.map",
    "dispatch.js",
    "dispatch.js.map",
    "index.d.ts",
    "index.d.ts.map",
    "index.js",
    "index.js.map",
    "jsonforms-lit.d.ts",
    "jsonforms-lit.d.ts.map",
    "jsonforms-lit.js",
    "jsonforms-lit.js.map",
    "renderers.d.ts",
    "renderers.d.ts.map",
    "renderers.js",
    "renderers.js.map",
    "store.d.ts",
    "store.d.ts.map",
    "store.js",
    "store.js.map"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && wtr",
    "test:dev": "npm run build && wtr"
  },
  "keywords": [
    "jsonforms",
    "lit",
    "web-components"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@jsonforms/core": "^3.8.0",
    "lit": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jsonforms/core": "^3.8.0",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@types/mocha": "^8.2.3",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.15.3",
    "@web/test-runner-playwright": "^0.9.0",
    "ajv": "^8.17.1",
    "lit": "^3.3.3",
    "playwright": "^1.60.0",
    "typescript": "~5.9.0"
  }
}
